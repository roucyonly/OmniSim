### === OmniSim Plan 2 验证 ===
### 先启动服务器: cd server && uvicorn app.main:app --reload

@baseUrl = http://localhost:8000
@world_id = {{world_id}}

### 1. 健康检查
GET {{baseUrl}}/api/health

# ### 2. 创建世界
# POST {{baseUrl}}/api/worlds
# Content-Type: application/json

# {
#     "name": "华山派",
#     "grid_size": 16,
#     "theme": "huashan"
# }

### 3. 记录返回的 world_id，替换下面的值
@world_id = 901b2599a44a

### 4. 创建令狐冲 (T1)
POST {{baseUrl}}/api/worlds/{{world_id}}/agents
Content-Type: application/json

{
    "name": "令狐冲",
    "tier": 1,
    "faction": "华山派",
    "role": "大弟子",
    "template": "弟子型",
    "x": 3,
    "y": 7,
    "location_name": "弟子精舍",
    "personality": "豁达洒脱，嗜酒如命，重情重义，反感繁文缛节",
    "core_motivation": "逍遥自由 = 师门情谊 > 门派规则",
    "initial_memory": "今天天气真好，可惜小师妹被师傅叫去练剑了。要是能偷偷下山去华阴县打几两好酒喝，那才是神仙日子。",
    "health": 100,
    "inner_power": 35,
    "sword_skill": 55,
    "talent": 80,
    "wisdom": 60,
    "charisma": 75,
    "perception": 55,
    "luck": 70,
    "speed": 3.0
}

### 5. 创建岳灵珊 (T1)
POST {{baseUrl}}/api/worlds/{{world_id}}/agents
Content-Type: application/json

{
    "name": "岳灵珊",
    "tier": 1,
    "faction": "华山派",
    "role": "小师妹",
    "template": "弟子型",
    "x": 4,
    "y": 7,
    "location_name": "弟子精舍",
    "personality": "活泼开朗，娇生惯养，心思单纯，依赖大师哥",
    "core_motivation": "追求新鲜感 = 依赖大师哥 > 刻苦修炼",
    "initial_memory": "爹爹今天又凶我了，说我剑法练得一塌糊涂。待会儿一定要去找大师哥，让他带我去后山捉野兔子玩！",
    "health": 100,
    "inner_power": 20,
    "sword_skill": 30,
    "talent": 45,
    "wisdom": 40,
    "charisma": 65,
    "perception": 50,
    "luck": 60,
    "speed": 2.5
}

